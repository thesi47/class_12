@model class_12.Models.PortfolioVM

@{
    ViewData["Title"] = "Portfolio";
}

<div class="container my-5">

    <div class="row">

        <!-- LEFT SIDE -->
        <div class="col-md-4">

            <div class="card shadow-sm border-0 p-4 text-center">

                @if (Model.PersonalInfo != null)
                {
                    @if (!string.IsNullOrEmpty(Model.PersonalInfo.ProfileImageUrl))
                    {
                        <img src="@Model.PersonalInfo.ProfileImageUrl"
                             class="rounded-circle mb-3 border mx-auto"
                             width="140"
                             height="140"  />
                    }

                    <h3 class="mb-1">@Model.PersonalInfo.FullName</h3>
                    <p class="text-muted mb-3">@Model.PersonalInfo.Title</p>

                    <hr />

                    <p class="mb-1">@Model.PersonalInfo.Email</p>
                    <p class="mb-1">@Model.PersonalInfo.Phone</p>
                    <p class="mb-3">@Model.PersonalInfo.Address</p>

                    <div class="d-flex gap-3 align-items-center text-center justify-content-center">

                        @if (!string.IsNullOrEmpty(Model.PersonalInfo.Github))
                        {
                            <a href="@Model.PersonalInfo.Github" target="_blank" class="text-dark fs-5">
                                <i class="bi bi-github"></i>
                            </a>
                        }

                        @if (!string.IsNullOrEmpty(Model.PersonalInfo.LinkedIn))
                        {
                            <a href="@Model.PersonalInfo.LinkedIn" target="_blank" class="text-primary fs-5">
                                <i class="bi bi-linkedin"></i>
                            </a>
                        }

                        @if (!string.IsNullOrEmpty(Model.PersonalInfo.Website))
                        {
                            <a href="@Model.PersonalInfo.Website" target="_blank" class="text-success fs-5">
                                <i class="bi bi-globe"></i>
                            </a>
                        }

                    </div>
                }

            </div>

        </div>

        <!-- RIGHT SIDE -->
        <div class="col-md-8">

            <!-- EXPERIENCE -->
            <div class="card shadow-sm border-0 p-4 mb-4">
                <h4 class="mb-3 border-bottom pb-2">Experience</h4>

                @if (Model.Experiences?.Any() == true)
                {
                    @foreach (var exp in Model.Experiences)
                    {
                        <div class="mb-4">

                            <h5 class="mb-1">@exp.Role</h5>
                            <div class="text-muted small mb-1">
                                @exp.Company |
                                @exp.Startdate.ToString("d") - @(exp.EndDate.HasValue ? exp.EndDate.Value.ToString("d") : "Present")
                            </div>

                            <p class="mb-0">@exp.Description</p>

                        </div>
                    }
                }
            </div>

            <!-- EDUCATION -->
            <div class="card shadow-sm border-0 p-4 mb-4">
                <h4 class="mb-3 border-bottom pb-2">Education</h4>

                @if (Model.Educations?.Any() == true)
                {
                    @foreach (var edu in Model.Educations)
                    {
                        <div class="mb-3">

                            <h5 class="mb-1">@edu.Degree</h5>
                            <div class="text-muted small">
                                @edu.Instituition
                            </div>
                            <div class="small">
                                @edu.StartDate.ToString("d") - @(edu.EndDate.HasValue ? edu.EndDate.Value.ToString("d") : "Present")
                            </div>

                        </div>
                    }
                }
            </div>

            <!-- SKILLS -->
            <div class="card shadow-sm border-0 p-4">
                <h4 class="mb-3 border-bottom pb-2">Skills</h4>

                <div class="d-flex flex-wrap gap-2">

                    @if (Model.Skills?.Any() == true)
                    {
                        @foreach (var skill in Model.Skills)
                        {
                            <span class="badge bg-light text-dark border px-3 py-2">
                                @skill.Name
                            </span>
                        }
                    }

                </div>
            </div>

        </div>
    </div>
</div>