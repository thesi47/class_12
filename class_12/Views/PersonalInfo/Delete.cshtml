@model class_12.Entities.PersonalInfo

@{
    ViewData["Title"] = "Delete Personal Information";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h1 class="text-danger">@ViewData["Title"]</h1>
            <div class="alert alert-danger" role="alert">
                Are you sure you want to delete this personal information?
            </div>

            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@Model.FullName</h5>
                    <p class="card-text">
                        <strong>Title:</strong> @Model.Title<br />
                        <strong>Email:</strong> @Model.Email<br />
                        <strong>Phone:</strong> @Model.Phone<br />
                        <strong>Address:</strong> @Model.Address
                    </p>
                </div>
            </div>

            <form asp-action="Delete" method="post" class="mt-3">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
