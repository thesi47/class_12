@model IEnumerable<class_12.Entities.PersonalInfo>

@{
    ViewData["Title"] = "Personal Information";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1>@ViewData["Title"]</h1>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Add New
            </a>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Profile Picture</th>
                        <th>Full Name</th>
                        <th>Title</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>

                                @if (!string.IsNullOrEmpty(item.ProfileImageUrl))
                                {
                                    <img src="~/uploads/@item.ProfileImageUrl" alt="Profile Image" width="100" height="100" />
                                }
                            </td>
                            <td>@item.FullName</td>
                            <td>@item.Title</td>
                            <td>@item.Email</td>
                            <td>@item.Phone</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">No personal information found. <a asp-action="Create">Create one</a></div>
    }
</div>
