@model class_12.Models.EducationVM

@{
    ViewData["Title"] = "Add Education";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h1>@ViewData["Title"]</h1>
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Instituition" class="form-label">Institution/School/University</label>
                    <input asp-for="Instituition" class="form-control" />
                    <span asp-validation-for="Instituition" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Degree" class="form-label">Degree</label>
                    <input asp-for="Degree" class="form-control" placeholder="e.g., Bachelor, Master, etc." />
                    <span asp-validation-for="Degree" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FieldOfStudy" class="form-label">Field of Study</label>
                    <input asp-for="FieldOfStudy" class="form-control" />
                    <span asp-validation-for="FieldOfStudy" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="StartDate" class="form-label">Start Date</label>
                    <input asp-for="StartDate" type="date" class="form-control" />
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EndDate" class="form-label">End Date (leave blank if ongoing)</label>
                    <input asp-for="EndDate" type="date" class="form-control" />
                    <span asp-validation-for="EndDate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-primary">Create</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
