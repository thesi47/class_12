@model class_12.Entities.ContactMessage

@{
    ViewData["Title"] = "View Contact Message";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h1>@ViewData["Title"]</h1>
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="SentAt" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">From</label>
                    <input asp-for="Name" class="form-control" readonly />
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" type="email" class="form-control" readonly />
                </div>

                <div class="mb-3">
                    <label asp-for="Subject" class="form-label">Subject</label>
                    <input asp-for="Subject" class="form-control" readonly />
                </div>

                <div class="mb-3">
                    <label asp-for="Message" class="form-label">Message</label>
                    <textarea asp-for="Message" class="form-control" rows="6" readonly></textarea>
                </div>

                <div class="mb-3">
                    <p><strong>Sent:</strong> @Model.SentAt.ToString("MMM dd, yyyy HH:mm:ss")</p>
                </div>

                <div class="mb-3">
                    <a asp-action="Index" class="btn btn-secondary">Back to Messages</a>
                </div>
            </form>
        </div>
    </div>
</div>
