@model class_12.Entities.ContactMessage

@{
    ViewData["Title"] = "Delete Contact Message";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h1 class="text-danger">@ViewData["Title"]</h1>
            <div class="alert alert-danger" role="alert">
                Are you sure you want to delete this message?
            </div>

            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@Model.Subject</h5>
                    <p class="card-text">
                        <strong>From:</strong> @Model.Name (@Model.Email)<br />
                        <strong>Sent:</strong> @Model.SentAt.ToString("MMM dd, yyyy HH:mm:ss")<br />
                        <strong>Message:</strong><br />
                        @Model.Message
                    </p>
                </div>
            </div>

            <form asp-action="Delete" method="post" class="mt-3">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
